{
  "name": "updateswh",
  "version": "0.9.3",
  "description": "updateswh",
  "main": "updateswh.js",
  "type": "module",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build:manifest": "node build/manifest-generator.js",
    "build": "npm run build:manifest && vite build",
    "dev": "vite build --watch",
    "lint": "eslint src/**/*.js extension/**/*.js",
    "test:chrome": "npm run build && node --experimental-vm-modules node_modules/.bin/jest --config tests/integration/jest.config.js",
    "test:e2e": "npm run build && node --experimental-vm-modules node_modules/.bin/jest --config tests/e2e/jest.config.js",
    "test:e2e:firefox": "npm run build && node --experimental-vm-modules node_modules/.bin/jest --config tests/e2e-firefox/jest.config.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rdicosmo/updateswh.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/rdicosmo/updateswh/issues"
  },
  "homepage": "https://github.com/rdicosmo/updateswh#readme",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@babel/preset-env": "^8.0.7",
    "babel-jest": "^30.5.2",
    "eslint": "^10.13.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "puppeteer-core": "^25.16.0",
    "vite": "^8.3.5"
  }
}
